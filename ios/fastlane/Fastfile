default_platform(:ios)

platform :ios do
  before_all do
    # Fetch from custom environment variables to avoid Fastlane's automatic env matching
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )
  end

  desc "Fetch certificates and provisioning profiles using match"
  lane :match_appstore do
    setup_ci
    match(
      type: "appstore",
      readonly: false,
      force: true
    )
    update_project_provisioning(
      xcodeproj: "Runner.xcodeproj",
      profile: ENV["sigh_com.vicente.losmooscles_appstore_profile-path"],
      target_filter: "^Runner$",
      build_configuration: "Release"
    )
    update_project_provisioning(
      xcodeproj: "Runner.xcodeproj",
      profile: ENV["sigh_com.vicente.losmooscles.watchkitapp_appstore_profile-path"],
      target_filter: "^WatchApp Watch App$",
      build_configuration: "Release"
    )
    update_project_provisioning(
      xcodeproj: "Runner.xcodeproj",
      profile: ENV["sigh_com.vicente.losmooscles.WorkoutWidgetExtension_appstore_profile-path"],
      target_filter: "^WorkoutWidgetExtension$",
      build_configuration: "Release"
    )
    update_project_provisioning(
      xcodeproj: "Runner.xcodeproj",
      profile: ENV["sigh_com.vicente.losmooscles.watchkitapp.WatchWidgetExtension_appstore_profile-path"],
      target_filter: "^WatchWidgetExtension$",
      build_configuration: "Release"
    )
    
    # Update project.pbxproj literal specifiers
    pbxproj_path = "Runner.xcodeproj/project.pbxproj"
    if File.exist?(pbxproj_path)
      content = File.read(pbxproj_path)
      content.gsub!("match AppStore com.vicente.losmooscles.watchkitapp.WatchWidgetExtension", ENV['sigh_com.vicente.losmooscles.watchkitapp.WatchWidgetExtension_appstore_profile-name'])
      content.gsub!("match AppStore com.vicente.losmooscles.WorkoutWidgetExtension", ENV['sigh_com.vicente.losmooscles.WorkoutWidgetExtension_appstore_profile-name'])
      content.gsub!("match AppStore com.vicente.losmooscles.watchkitapp", ENV['sigh_com.vicente.losmooscles.watchkitapp_appstore_profile-name'])
      content.gsub!("match AppStore com.vicente.losmooscles", ENV['sigh_com.vicente.losmooscles_appstore_profile-name'])
      File.write(pbxproj_path, content)
      UI.message("Successfully updated project.pbxproj with new profile specifiers!")
    end

    # Update ExportOptions.plist
    plist_path = "ExportOptions.plist"
    if File.exist?(plist_path)
      content = File.read(plist_path)
      content.gsub!("match AppStore com.vicente.losmooscles.watchkitapp.WatchWidgetExtension", ENV['sigh_com.vicente.losmooscles.watchkitapp.WatchWidgetExtension_appstore_profile-name'])
      content.gsub!("match AppStore com.vicente.losmooscles.WorkoutWidgetExtension", ENV['sigh_com.vicente.losmooscles.WorkoutWidgetExtension_appstore_profile-name'])
      content.gsub!("match AppStore com.vicente.losmooscles.watchkitapp", ENV['sigh_com.vicente.losmooscles.watchkitapp_appstore_profile-name'])
      content.gsub!("match AppStore com.vicente.losmooscles", ENV['sigh_com.vicente.losmooscles_appstore_profile-name'])
      File.write(plist_path, content)
      UI.message("Successfully updated ExportOptions.plist with new profile names!")
    end
  end

  desc "Generate new certificates and profiles"
  lane :generate_certs do
    match(
      type: "appstore",
      readonly: false,
      force: true
    )
  end

  desc "Nuke and generate new certificates and profiles"
  lane :nuke_and_generate do
    match_nuke(
      type: "appstore",
      skip_confirmation: true
    )
    match(
      type: "appstore",
      readonly: false,
      force: true
    )
  end
end
