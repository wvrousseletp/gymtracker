default_platform(:ios)

platform :ios do
  before_all do
    if ENV["ASC_KEY_ID"] && !ENV["ASC_KEY_ID"].empty?
      app_store_connect_api_key(
        key_id: ENV["ASC_KEY_ID"],
        issuer_id: ENV["ASC_ISSUER_ID"],
        key_content: ENV["ASC_KEY_CONTENT_B64"],
        is_key_content_base64: true,
        in_house: false
      )
    end
  end

  desc "Release new version to TestFlight"
  lane :release do
    setup_ci
    ENV["FASTLANE_MATCH_READONLY"] = "false"

    match(
      type: "appstore",
      readonly: false,
      renew_expired_certs: true,
      app_identifier: [
        "com.vicente.losmooscles",
        "com.vicente.losmooscles.watchkitapp",
        "com.vicente.losmooscles.watchkitapp.WatchWidgetExtension",
        "com.vicente.losmooscles.WorkoutWidgetExtension"
      ]
    )

    mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "PJ32UPL29J",
      code_sign_identity: "Apple Distribution",
      targets: ["Runner"],
      profile_name: mapping["com.vicente.losmooscles"]
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "PJ32UPL29J",
      code_sign_identity: "Apple Distribution",
      targets: ["WatchApp Watch App"],
      profile_name: mapping["com.vicente.losmooscles.watchkitapp"]
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "PJ32UPL29J",
      code_sign_identity: "Apple Distribution",
      targets: ["WatchWidgetExtension"],
      profile_name: mapping["com.vicente.losmooscles.watchkitapp.WatchWidgetExtension"]
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "PJ32UPL29J",
      code_sign_identity: "Apple Distribution",
      targets: ["WorkoutWidgetExtension"],
      profile_name: mapping["com.vicente.losmooscles.WorkoutWidgetExtension"]
    )

    gym(
      scheme: "Runner",
      clean: true,
      export_method: "app-store"
    )
    pilot(
      skip_waiting_for_build_processing: true
    )
  end
end
