default_platform(:ios)

platform :ios do
  before_all do
    # Fetch from custom environment variables to avoid Fastlane's automatic env matching
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: false,
      in_house: false
    )
  end

  desc "Fetch certificates and provisioning profiles using match"
  lane :match_appstore do
    setup_ci
    match(
      type: "appstore",
      readonly: false,
      force: true
    )
    update_project_provisioning(
      xcodeproj: "Runner.xcodeproj",
      profile: ENV["sigh_com.vicente.losmooscles_appstore_profile-path"],
      target_filter: "^Runner$",
      build_configuration: "Release"
    )
    update_project_provisioning(
      xcodeproj: "Runner.xcodeproj",
      profile: ENV["sigh_com.vicente.losmooscles.watchkitapp_appstore_profile-path"],
      target_filter: "^WatchApp Watch App$",
      build_configuration: "Release"
    )
    update_project_provisioning(
      xcodeproj: "Runner.xcodeproj",
      profile: ENV["sigh_com.vicente.losmooscles.WorkoutWidgetExtension_appstore_profile-path"],
      target_filter: "^WorkoutWidget$",
      build_configuration: "Release"
    )
    update_project_provisioning(
      xcodeproj: "Runner.xcodeproj",
      profile: ENV["sigh_com.vicente.losmooscles.watchkitapp.WatchWidgetExtension_appstore_profile-path"],
      target_filter: "^WatchWidgetExtension$",
      build_configuration: "Release"
    )
    
    # Update ExportOptions.plist
    plist_path = "ExportOptions.plist"
    if File.exist?(plist_path)
      plist_content = File.read(plist_path)
      plist_content.gsub!(
        /<key>com\.vicente\.losmooscles<\/key>\s*<string>[^<]+<\/string>/,
        "<key>com.vicente.losmooscles</key>\n\t\t<string>#{ENV['sigh_com.vicente.losmooscles_appstore_profile-name']}</string>"
      )
      plist_content.gsub!(
        /<key>com\.vicente\.losmooscles\.watchkitapp<\/key>\s*<string>[^<]+<\/string>/,
        "<key>com.vicente.losmooscles.watchkitapp</key>\n\t\t<string>#{ENV['sigh_com.vicente.losmooscles.watchkitapp_appstore_profile-name']}</string>"
      )
      plist_content.gsub!(
        /<key>com\.vicente\.losmooscles\.WorkoutWidgetExtension<\/key>\s*<string>[^<]+<\/string>/,
        "<key>com.vicente.losmooscles.WorkoutWidgetExtension</key>\n\t\t<string>#{ENV['sigh_com.vicente.losmooscles.WorkoutWidgetExtension_appstore_profile-name']}</string>"
      )
      plist_content.gsub!(
        /<key>com\.vicente\.losmooscles\.watchkitapp\.WatchWidgetExtension<\/key>\s*<string>[^<]+<\/string>/,
        "<key>com.vicente.losmooscles.watchkitapp.WatchWidgetExtension</key>\n\t\t<string>#{ENV['sigh_com.vicente.losmooscles.watchkitapp.WatchWidgetExtension_appstore_profile-name']}</string>"
      )
      File.write(plist_path, plist_content)
      UI.message("Successfully updated ExportOptions.plist with new profile names!")
    end
  end

  desc "Generate new certificates and profiles"
  lane :generate_certs do
    match(
      type: "appstore",
      readonly: false,
      force: true
    )
  end

  desc "Nuke and generate new certificates and profiles"
  lane :nuke_and_generate do
    match_nuke(
      type: "appstore",
      skip_confirmation: true
    )
    match(
      type: "appstore",
      readonly: false,
      force: true
    )
  end
end
